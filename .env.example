# Copy this to .env and fill in real values. Never commit the real .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres via Homebrew (no Docker needed):
#   brew install postgresql@16
#   brew services start postgresql@16
#   createdb baseball_club
DATABASE_URL=postgres://localhost/baseball_club

TIME_ZONE=America/Denver

# Leave USE_R2=False locally to save uploads to ./media instead.
USE_R2=False
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=

# Leave EMAIL_BACKEND unset locally to print emails to the console instead of
# sending them. Set these on Railway to send for real -- NOT SMTP, Railway
# blocks all outbound SMTP ports at the network level (confirmed by testing),
# so this goes through Resend's HTTPS API instead via django-anymail:
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=onboarding@resend.dev
